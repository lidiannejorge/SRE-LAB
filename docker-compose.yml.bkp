services:


  nginx:

    image: nginx:latest

    container_name: sre-nginx


    ports:

      - "${NGINX_PORT}:80"


    depends_on:

      api:

        condition: service_healthy


    volumes:

      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro


    restart: unless-stopped


    networks:

      - sre-network



  api:


    build:

      context: ../../apps/api


    image: sre-api:latest


    container_name: sre-api


    ports:

      - "${API_PORT}:5000"


    environment:

      APP_NAME: ${APP_NAME}

      ENVIRONMENT: ${ENVIRONMENT}



    healthcheck:

      test:

        [
          "CMD",
          "curl",
          "-f",
          "http://localhost:5000/health"
        ]


      interval: 30s

      timeout: 10s

      retries: 3

      start_period: 10s



    restart: unless-stopped


    networks:

      - sre-network





  prometheus:


    image: prom/prometheus:latest


    container_name: sre-prometheus



    ports:

      - "${PROMETHEUS_PORT}:9090"



    volumes:

      - ../../monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro



    depends_on:

      api:

        condition: service_healthy



    restart: unless-stopped



    networks:

      - sre-network





  grafana:


    image: grafana/grafana:latest


    container_name: sre-grafana



    ports:

      - "${GRAFANA_PORT}:3000"



    depends_on:

      - prometheus



    volumes:

      - grafana-data:/var/lib/grafana



    restart: unless-stopped



    networks:

      - sre-network





  node-exporter:


    image: prom/node-exporter:latest


    container_name: sre-node-exporter



    ports:

      - "${NODE_EXPORTER_PORT}:9100"



    restart: unless-stopped



    networks:

      - sre-network





networks:


  sre-network:


    driver: bridge





volumes:


  grafana-data:
