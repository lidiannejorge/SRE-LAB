services:

  api:

    build:
      context: .
      dockerfile: apps/api/Dockerfile

    image: sre-api:latest

    container_name: sre-api

    ports:
      - "5000:5000"

    environment:
      APP_NAME: SRE-LAB
      ENVIRONMENT: dev

      OTEL_SERVICE_NAME: sre-api
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4318

    depends_on:
      - otel-collector
      - postgres

    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')"
        ]

      interval: 10s
      timeout: 5s
      retries: 5

    networks:
      - sre-network



  cliente-service:

    build:
      context: .
      dockerfile: services/cliente-service/Dockerfile

    image: cliente-service:latest

    container_name: sre-cliente-service

    ports:
      - "5001:5001"


    environment:

      DB_HOST: postgres
      DB_NAME: sre_database
      DB_USER: sre_user
      DB_PASSWORD: sre_password

      OTEL_SERVICE_NAME: cliente-service
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4318


    healthcheck:

      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:5001/health')"
        ]

      interval: 10s
      timeout: 5s
      retries: 5


    depends_on:
      - postgres
      - otel-collector


    networks:
      - sre-network




  pedido-service:


    build:

      context: .

      dockerfile: services/pedido-service/Dockerfile


    image: pedido-service:latest


    container_name: sre-pedido-service


    ports:

      - "5002:5002"



    environment:


      DB_HOST: postgres

      DB_NAME: sre_database

      DB_USER: sre_user

      DB_PASSWORD: sre_password


      OTEL_SERVICE_NAME: pedido-service

      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4318



    healthcheck:


      test:

        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:5002/health')"
        ]


      interval: 10s

      timeout: 5s

      retries: 5



    depends_on:

      - postgres

      - otel-collector



    networks:

      - sre-network
  load-generator:

    build:

      context: ./load-generator


    image: sre-load-generator:latest


    container_name: sre-load-generator


    depends_on:

      - api

      - cliente-service

      - pedido-service


    networks:

      - sre-network





  postgres:


    image: postgres:16


    container_name: sre-postgres


    ports:

      - "5432:5432"



    environment:


      POSTGRES_DB: sre_database

      POSTGRES_USER: sre_user

      POSTGRES_PASSWORD: sre_password



    healthcheck:

      test:
        [
          "CMD-SHELL",
          "pg_isready -U sre_user -d sre_database"
        ]

      interval: 10s

      timeout: 5s

      retries: 5



    volumes:


      - postgres-data:/var/lib/postgresql/data



    networks:


      - sre-network






  postgres-exporter:


    image: prometheuscommunity/postgres-exporter:latest


    container_name: sre-postgres-exporter


    ports:


      - "9187:9187"



    environment:


      DATA_SOURCE_NAME: postgresql://sre_user:sre_password@postgres:5432/sre_database?sslmode=disable



    depends_on:


      - postgres



    networks:


      - sre-network
  prometheus:


    image: prom/prometheus:latest


    container_name: sre-prometheus


    ports:


      - "9090:9090"



    volumes:


      - ./monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml



    depends_on:

      - api
      - cliente-service
      - pedido-service
      - node-exporter
      - postgres-exporter



    networks:


      - sre-network






  grafana:


    image: grafana/grafana:latest


    container_name: sre-grafana


    ports:


      - "3000:3000"



    volumes:


      - grafana-data:/var/lib/grafana



    depends_on:

      - prometheus

      - loki



    networks:


      - sre-network






  otel-collector:


    image: otel/opentelemetry-collector-contrib:latest


    container_name: sre-otel-collector



    command:


      - "--config=/etc/otelcol/config.yaml"



    ports:


      - "4317:4317"

      - "4318:4318"

      - "8889:8889"



    volumes:


      - ./monitoring/otel-collector/config.yaml:/etc/otelcol/config.yaml



    networks:


      - sre-network






  jaeger:


    image: jaegertracing/all-in-one:latest


    container_name: sre-jaeger



    ports:


      - "16686:16686"

      - "14250:14250"



    networks:


      - sre-network






  node-exporter:


    image: prom/node-exporter:latest


    container_name: sre-node-exporter



    ports:


      - "9100:9100"



    networks:


      - sre-network






  loki:


    image: grafana/loki:latest


    container_name: sre-loki



    ports:


      - "3100:3100"



    command:


      - "-config.file=/etc/loki/local-config.yaml"



    volumes:


      - ./monitoring/loki/loki-config.yaml:/etc/loki/local-config.yaml



    networks:


      - sre-network






  promtail:


    image: grafana/promtail:latest


    container_name: sre-promtail



    volumes:


      - ./monitoring/promtail/promtail-config.yaml:/etc/promtail/config.yaml

      - /var/lib/docker/containers:/var/lib/docker/containers:ro

      - /var/run/docker.sock:/var/run/docker.sock



    command:


      - "-config.file=/etc/promtail/config.yaml"



    depends_on:


      - loki



    networks:


      - sre-network
networks:


  sre-network:


    driver: bridge





volumes:


  postgres-data:


  grafana-data:
