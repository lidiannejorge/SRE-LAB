services:


  api:

    build:
      context: ./apps/api

    image: sre-api:latest

    container_name: sre-api

    ports:
      - "5000:5000"

    environment:
      APP_NAME: SRE-LAB
      ENVIRONMENT: dev

    healthcheck:
      test:
        [
          "CMD",
          "curl",
          "-f",
          "http://localhost:5000/health"
        ]

      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

    restart: unless-stopped

    networks:
      - sre-network



  cliente-service:

    build:

      context: ./services/cliente-service


    image: cliente-service:latest


    container_name: sre-cliente-service


    ports:

      - "5001:5001"


    environment:

      DB_HOST: sre-postgres

      DB_NAME: sre_database

      DB_USER: sre_user

      DB_PASSWORD: sre_password


    depends_on:

      postgres:

        condition: service_healthy


    restart: unless-stopped


    networks:

      - sre-network





  postgres:

    image: postgres:16


    container_name: sre-postgres


    environment:

      POSTGRES_DB: sre_database

      POSTGRES_USER: sre_user

      POSTGRES_PASSWORD: sre_password


    ports:

      - "5432:5432"


    volumes:

      - postgres-data:/var/lib/postgresql/data

      - ./database/postgres/init.sql:/docker-entrypoint-initdb.d/init.sql:ro


    healthcheck:

      test:

        [
          "CMD-SHELL",
          "pg_isready -U sre_user -d sre_database"
        ]

      interval: 10s

      timeout: 5s

      retries: 5


    restart: unless-stopped


    networks:

      - sre-network





  prometheus:


    image: prom/prometheus:latest


    container_name: sre-prometheus


    ports:

      - "9090:9090"


    volumes:

      - ./monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro


    depends_on:

      api:

        condition: service_healthy


    restart: unless-stopped


    networks:

      - sre-network





  grafana:


    image: grafana/grafana:latest


    container_name: sre-grafana


    ports:

      - "3000:3000"


    depends_on:

      - prometheus


    volumes:

      - grafana-data:/var/lib/grafana


    restart: unless-stopped


    networks:

      - sre-network





  node-exporter:


    image: prom/node-exporter:latest


    container_name: sre-node-exporter


    ports:

      - "9100:9100"


    restart: unless-stopped


    networks:

      - sre-network





networks:


  sre-network:


    driver: bridge





volumes:


  grafana-data:


  postgres-data:
